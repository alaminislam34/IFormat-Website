# ==============================================================================
# iFormat Environment Variables (Docker Production / Staging)
# ==============================================================================

# Database Credentials (AWS RDS PostgreSQL or Containerized Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=iformat_db
DATABASE_URL=postgresql://postgres:your_password@database-1.c5go6iqueuo9.eu-central-1.rds.amazonaws.com:5432/iformat_db?schema=public&sslmode=prefer

# Application URLs & Gateway
CORS_ORIGIN=https://iformat.com,https://www.iformat.com
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_USE_MOCK=false

# Security & JWT Secrets (Min 32 characters)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
COOKIE_DOMAIN=iformat.com
COOKIE_SECURE=true

# AI Microservice (FastAPI + AWS Bedrock)
AI_SERVICE_URL=http://10.10.28.89:8010
AI_SERVICE_TIMEOUT_MS=60000

# OpenAI API Key (Optional Fallback)
OPENAI_API_KEY=sk-proj-your_actual_openai_key

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://iformat.com/api/v1/oauth/google/callback
OAUTH_SUCCESS_REDIRECT_URL=https://iformat.com/account-type
OAUTH_FAILURE_REDIRECT_URL=https://iformat.com/login?error=oauth_failed

# Stripe Billing & Subscriptions
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_connect_webhook_secret
PRODUCT_ID=prod_your_stripe_product_id

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=ifromat-media-db

# SMTP Email Transport (AWS Mail Manager / SES)
SMTP_HOST=he24ywr9xaq8.eig6.mail-manager-smtp.amazonaws.com
SMTP_PORT=587
SMTP_USER=inp-jd5t3cspuqeokrdurk3gzhto
SMTP_PASS=your_smtp_password
SMTP_FROM=iFormat <support@iformat.com>

# Redis (Optional: Distributed Rate Limiting & Cache)
REDIS_URL=redis://redis:6379
