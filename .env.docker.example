# ==============================================================================
# iFormat Environment Variables (Docker Production / Staging)
# ==============================================================================

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=iformat_db
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@postgres:5432/iformat_db?schema=public

# Application URLs
CORS_ORIGIN=https://iformat.com,https://www.iformat.com
NEXT_PUBLIC_API_URL=/api/v1

# Security & Secrets
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars

# OpenAI API Key
OPENAI_API_KEY=sk-proj-your_actual_openai_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://iformat.com/api/v1/oauth/google/callback

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=iformat-uploads

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@iformat.com
SMTP_PASS=your_app_password
SMTP_FROM=iFormat <notifications@iformat.com>
