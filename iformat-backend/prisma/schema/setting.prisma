model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy   User?    @relation("UserUpdatedSettings", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([key])
}

model ContactInquiry {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  phone     String?
  message   String
  status    String   @default("UNREAD") // UNREAD, CONTACTED, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
}
