model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  payload   Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
