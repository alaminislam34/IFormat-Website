model ConsultationSlot {
  id           String    @id @default(uuid())
  advisorId    String
  title        String    @default("CV & Career Strategy Session")
  startTime    DateTime
  endTime      DateTime
  isBooked     Boolean   @default(false)
  priceInCents Int       @default(4900)
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  advisor      User      @relation("AdvisorSlots", fields: [advisorId], references: [id], onDelete: Cascade)
  booking      Booking?

  @@index([advisorId, startTime])
  @@index([isBooked, startTime])
}

model Booking {
  id              String            @id @default(uuid())
  slotId          String?           @unique
  userId          String
  serviceId       String?
  serviceTitle    String?
  priceInCents    Int               @default(0)
  clientPhone     String?
  requirements    String?
  notes           String?
  paymentStatus   String            @default("PAID")
  stripeSessionId String?
  status          BookingStatus     @default(CONFIRMED)
  isDeleted       Boolean           @default(false)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  slot            ConsultationSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  user            User              @relation("UserBookings", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDeleted])
  @@index([serviceId])
  @@index([paymentStatus])
}
