model Plan {
  id                          String              @id @default(uuid())
  code                        String              @unique
  name                        String
  description                 String?
  priceInCents                Int                 @default(0)
  currency                    String              @default("USD")
  billingInterval             PlanBillingInterval @default(MONTHLY)
  targetAudience              PlanAudience        @default(EMPLOYER)
  isActive                    Boolean             @default(true)
  stripePriceId               String?             @unique
  stripeProductId             String?

  // Entitlements & limits
  maxActiveJobs               Int?
  maxApplicationsPerMonth     Int?
  aiScreeningEnabled          Boolean             @default(false)
  featuredJobPlacement        Boolean             @default(false)
  unmaskedApplicantProfiles   Boolean             @default(false)
  unlimitedCvTemplates        Boolean             @default(false)
  consultationDiscountPercent Int                 @default(0)
  customFeatures              Json?
  isDeleted                   Boolean             @default(false)
  deletedAt                   DateTime?

  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  subscriptions               Subscription[]

  @@index([targetAudience, isActive, isDeleted])
  @@index([code])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([stripeSubscriptionId])
}

model WebhookEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  eventType     String
  processedAt   DateTime @default(now())
  payload       Json?

  @@index([stripeEventId])
}

model SubscriptionUsage {
  id                String   @id @default(uuid())
  userId            String
  periodStart       DateTime
  periodEnd         DateTime
  jobsPostedCount   Int      @default(0)
  applicationsCount Int      @default(0)
  aiScreeningsCount Int      @default(0)
  aiGenerationsCount Int     @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart, periodEnd])
  @@index([userId])
}
