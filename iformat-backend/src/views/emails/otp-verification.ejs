<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1e293b; line-height: 1.6;">
  <h2 style="color: #0A54B1; margin-top: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.3px;">
    Verification Code
  </h2>
  
  <p style="font-size: 15px; margin: 0 0 16px 0; color: #334155;">
    Hello <strong><%= name || 'there' %></strong>,
  </p>

  <p style="font-size: 15px; margin: 0 0 24px 0; color: #475569;">
    Use the 6-digit verification code below to securely verify your account on iFormat:
  </p>

  <!-- OTP Code Display Card -->
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 24px 0;">
    <tr>
      <td align="center">
        <div style="display: inline-block; background: #f0f7ff; border: 2px dashed #0A54B1; border-radius: 14px; padding: 18px 36px; text-align: center;">
          <span style="font-family: 'Courier New', Courier, monospace, sans-serif; font-size: 34px; font-weight: 800; letter-spacing: 10px; color: #0A54B1; display: block; margin-left: 10px;">
            <%= code %>
          </span>
          <span style="display: block; font-size: 12px; font-weight: 600; color: #0284c7; margin-top: 6px; text-transform: uppercase; letter-spacing: 1px;">
            Expires in 10 minutes
          </span>
        </div>
      </td>
    </tr>
  </table>

  <!-- Expiry and Security Box -->
  <div style="background-color: #f8fafc; border-left: 4px solid #0A54B1; border-radius: 4px; padding: 14px 16px; margin: 24px 0;">
    <p style="margin: 0; font-size: 13px; color: #475569; line-height: 1.5;">
      <strong>Security Notice:</strong> Never share this code with anyone. iFormat representatives will never ask for your verification code or password.
    </p>
  </div>

  <p style="font-size: 13px; color: #64748b; margin-top: 24px;">
    If you did not request this verification code, no further action is required. Your account remains completely secure.
  </p>
</div>
