<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1e293b; line-height: 1.6;">
  <h2 style="color: #0A54B1; margin-top: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.3px;">
    Password Reset Request
  </h2>

  <p style="font-size: 15px; margin: 0 0 16px 0; color: #334155;">
    Hello <strong><%= name || 'there' %></strong>,
  </p>

  <p style="font-size: 15px; margin: 0 0 20px 0; color: #475569;">
    We received a request to reset your password for your iFormat account.
  </p>

  <% if (typeof code !== 'undefined' && code) { %>
  <!-- 6-digit OTP Box -->
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 20px 0;">
    <tr>
      <td align="center">
        <div style="display: inline-block; background: #f0f7ff; border: 2px dashed #0A54B1; border-radius: 14px; padding: 16px 32px; text-align: center;">
          <span style="font-family: 'Courier New', Courier, monospace, sans-serif; font-size: 32px; font-weight: 800; letter-spacing: 8px; color: #0A54B1; display: block; margin-left: 8px;">
            <%= code %>
          </span>
          <span style="display: block; font-size: 11px; font-weight: 600; color: #0284c7; margin-top: 4px; text-transform: uppercase; letter-spacing: 1px;">
            Your 6-Digit Reset Code
          </span>
        </div>
      </td>
    </tr>
  </table>
  <% } %>

  <% if (typeof resetUrl !== 'undefined' && resetUrl) { %>
  <p style="font-size: 14px; color: #475569; margin: 16px 0 8px 0; text-align: center;">
    Or click the button below to reset your password directly:
  </p>
  <div style="text-align: center; margin: 16px 0 24px 0;">
    <a href="<%= resetUrl %>" class="btn">Reset My Password</a>
  </div>
  <% } %>

  <div style="background-color: #f8fafc; border-left: 4px solid #0A54B1; border-radius: 4px; padding: 14px 16px; margin: 24px 0;">
    <p style="margin: 0; font-size: 13px; color: #475569; line-height: 1.5;">
      <strong>Security Notice:</strong> This code and link will expire in 10 minutes. If you did not make this request, you can safely ignore this email.
    </p>
  </div>
</div>
